<com.archos.mediacenter.video.player.PlayerControlsRelativeLayout xmlns:ads="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/playerControllers" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_weight="1">

    <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_alignParentTop="true" android:layout_marginEnd="32dp" android:layout_marginTop="24dp" android:textColor="#FFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/preview_playback_title" android:layout_width="560dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="19sp" android:layout_alignParentTop="true" android:layout_alignParentStart="true" android:layout_marginStart="32dp" android:layout_marginTop="24dp" android:visibility="gone" android:shadowColor="#FF000000" android:shadowRadius="3" />

    <TextView android:id="@+id/preview_playback_episode" android:layout_width="560dp" android:layout_height="wrap_content" android:layout_below="@id/preview_playback_title" android:layout_marginStart="32dp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="#CCDFEA" android:textSize="13sp" android:visibility="gone"/>
    <FrameLayout android:id="@+id/tv_menu_container" android:layout_width="match_parent" android:layout_height="match_parent">

        <FrameLayout android:id="@+id/my_recycler_view" android:layout_width="wrap_content" android:layout_height="match_parent" android:scrollbars="horizontal">
        </FrameLayout>
    </FrameLayout>

    <include android:layout_width="@dimen/player2014_bar_width" android:layout_height="fill_parent" android:layout_above="@+id/control_bar" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" layout="@layout/player_controller_left" />

    <include android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/control_bar" layout="@layout/player_help_overlay" />

    <include android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/unlock_instructions" layout="@layout/unlock_instructions" />

    

    <LinearLayout android:id="@+id/control_bar" android:layout_width="match_parent" android:layout_height="126dp" android:layout_alignParentBottom="true" android:background="@drawable/mark_hud_background" android:descendantFocusability="afterDescendants" android:orientation="vertical" android:visibility="gone" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="16dp" android:paddingBottom="12dp">
      <com.archos.mediacenter.utils.seekbar.ArchosProgressSlider android:id="@+id/seek_progress" style="@style/PlayerSliderHorizontal" android:layout_width="match_parent" android:layout_height="18dp" android:minHeight="4dp" android:maxHeight="4dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:progressDrawable="@drawable/preview_seek_track" android:thumb="@drawable/preview_seek_thumb" android:thumbOffset="5dp"/>
      <RelativeLayout android:layout_width="match_parent" android:layout_height="22dp">
        <TextView android:id="@+id/time_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:textSize="12sp" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:textSize="12sp" android:textColor="#FFFFFF"/>
        <ProgressBar android:id="@+id/seek_state" style="?android:attr/progressBarStyleSmall" android:layout_width="16dp" android:layout_height="16dp" android:layout_centerHorizontal="true" android:visibility="gone"/>
      </RelativeLayout>
      <RelativeLayout android:layout_width="match_parent" android:layout_height="46dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentStart="true" android:orientation="horizontal"><LinearLayout android:layout_width="96dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/preview_subtitles" android:layout_width="38dp" android:layout_height="28dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="4dp" android:scaleType="fitCenter" android:src="@drawable/tv_subtitles" android:background="@drawable/mark_hud_focus" android:contentDescription="subtitles"/><TextView android:id="@+id/preview_subtitle_label" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="9sp" android:textColor="#CCDFEA" android:gravity="center" android:singleLine="true" android:ellipsize="end"/></LinearLayout><LinearLayout android:layout_width="96dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/preview_audio" android:layout_width="38dp" android:layout_height="28dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="4dp" android:scaleType="fitCenter" android:src="@drawable/tv_languages" android:background="@drawable/mark_hud_focus" android:contentDescription="audio"/><TextView android:id="@+id/preview_audio_label" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="9sp" android:textColor="#CCDFEA" android:gravity="center" android:singleLine="true" android:ellipsize="end"/></LinearLayout></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_centerHorizontal="true" android:gravity="center" android:orientation="horizontal"><ImageButton android:id="@+id/preview_previous" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_previous" android:background="@drawable/mark_hud_focus" android:contentDescription="Previous episode"/><ImageButton android:id="@+id/backward" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_rewind10" android:background="@drawable/mark_hud_focus" android:contentDescription="Rewind 10 seconds"/><ImageButton android:id="@+id/pause" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/video_play_selector" android:background="@drawable/mark_hud_focus" android:contentDescription="Play or pause"/><ImageButton android:id="@+id/forward" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_forward10" android:background="@drawable/mark_hud_focus" android:contentDescription="Forward 10 seconds"/><ImageButton android:id="@+id/preview_next" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_next" android:background="@drawable/mark_hud_focus" android:contentDescription="Next episode"/></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:orientation="horizontal"><ImageButton android:id="@+id/preview_speed" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_speed" android:background="@drawable/mark_hud_focus" android:contentDescription="Playback speed"/><ImageButton android:id="@+id/preview_info" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_info" android:background="@drawable/mark_hud_focus" android:contentDescription="More Info"/><ImageButton android:id="@+id/preview_more" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_more" android:background="@drawable/mark_hud_focus" android:contentDescription="More playback options"/></LinearLayout>
        <ImageButton android:id="@+id/format" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/video_format_0" android:visibility="gone" android:focusable="false" android:contentDescription="Aspect ratio"/>
        <ImageButton android:id="@+id/fullscreen_cutouts" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/video_fullscreen_cutout_off" android:visibility="gone" android:focusable="false" android:contentDescription="Fullscreen"/>
      </RelativeLayout>
    </LinearLayout>

    <TextView android:id="@+id/osd_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="84dp" android:drawableStart="@drawable/ic_volume" android:text="15" android:textColor="@color/white" android:textSize="20sp" android:lineSpacingMultiplier="1.1" android:background="@drawable/rounded_rectangle" android:visibility="invisible" android:layout_marginTop="60dp" android:layout_alignParentStart="true" android:layout_marginStart="46dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6sp" android:paddingBottom="6sp" />

    <TextView android:id="@+id/osd_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="84dp" android:drawableStart="@drawable/ic_brightness" android:text="15" android:textColor="@color/white" android:textSize="20sp" android:lineSpacingMultiplier="1.1" android:background="@drawable/rounded_rectangle" android:visibility="invisible" android:layout_marginTop="60dp" android:layout_alignParentEnd="true" android:layout_marginEnd="30dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6sp" android:paddingBottom="6sp" />

</com.archos.mediacenter.video.player.PlayerControlsRelativeLayout>
